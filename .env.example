# ─────────────────────────────────────────────────────────────────────────────
# Neetirth environment variables
# Copy to .env.local for local development. NEVER commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────────────────────
# Create a project at https://supabase.com/dashboard and copy these values.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Service role key — used ONLY in serverless functions / server-side code.
# NEVER expose this in the browser or commit it to the repo.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Admin ───────────────────────────────────────────────────────────────────
# Admin dashboard requires authenticated Supabase users with the "admin" role.
# Create an admin user via Supabase dashboard → Authentication → Users,
# then assign the role via the SQL console:
#   INSERT INTO admin_users (user_id, email, role) VALUES ('<uid>', '<email>', 'admin');

# ── AI (optional) ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-key
